.edition h1,.edition h2{background:#f5f8fc;border-top:2px solid #003da5;border-bottom:1px solid #b8c9e1;padding:16px 12px;overflow-wrap:break-word}.hero-grid{grid-template-columns:repeat(3,minmax(0,1fr))}.hero-grid img{object-fit:contain;background:#f8fafc}.wide-photo img{object-fit:contain}td .up,td .down{display:block;text-align:right}@media(max-width:650px){.hero-grid{grid-template-columns:1fr}.hero-grid img{height:auto;max-height:360px}} </style>

