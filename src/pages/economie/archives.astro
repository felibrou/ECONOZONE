---
import Layout from '../../layouts/Layout.astro';

const analyses = [
  { date: '2026-10-05', label: '5 octobre 2026 — clôture', title: 'UEMOA : marchés publics, protection sociale et financement', href: '/economie/2026-10-05-cloture' },
  { date: '2026-10-05', label: '5 octobre 2026', title: 'BCEAO : liquidité et inégalités du crédit', href: '/economie/2026-10-05' },
  { date: '2026-10-04', label: '4 octobre 2026', title: 'Prix alimentaires : le répit régional reste exposé aux céréales', href: '/economie/2026-10-04' },
  { date: '2026-10-01', label: '1er octobre 2026', title: 'PI-SPI : 175 participants autorisés et effets sur les services', href: '/economie/2026-10-01' },
  { date: '2026-09-30', label: '30 septembre 2026', title: 'Ghana : projet minier et retombées économiques régionales', href: '/economie/2026-09-30' },
  { date: '2026-09-29', label: '29 septembre 2026', title: 'Paiements instantanés : échéance de connexion à PI-SPI', href: '/economie/2026-09-29' },

  { date: '2026-09-28', label: '28 septembre 2026', title: 'Mines, énergie et microfinance en Afrique de l’Ouest', href: '/economie/2026-09-28' },
  { date: '2026-09-25', label: '25 septembre 2026', title: 'UEMOA : rebond boursier, pétrole cher et vigilance sur les équilibres régionaux', href: '/economie/2026-09-25' },
  { date: '2026-09-24', label: '24 septembre 2026', title: 'UEMOA : croissance robuste, pétrole cher et taux BCEAO inchangés', href: '/economie/2026-09-24' },
];
---
<Layout title="ECONOZONE — Archives économiques">
  <div class="breadcrumb">ECONOZONE &rsaquo; Économie &rsaquo; Archives</div>
  <h1>Archives économiques</h1>
  <p class="dek">Analyses économiques datées d’ECONOZONE sur l’UEMOA et l’Afrique de l’Ouest.</p>
  <div class="archive-list">
    {analyses.map(a => (
      <a class="archive-row" href={a.href}>
        <span><b>{a.label}</b><br /><small>{a.title}</small></span>
        <span class="archive-link">Lire →</span>
      </a>
    ))}
  </div>
</Layout>
<style>
  .archive-list { display:flex; flex-direction:column; gap:1px; background:var(--border); border:1px solid var(--border); margin-top:20px; }
  .archive-row { background:var(--panel); padding:16px 18px; display:flex; justify-content:space-between; gap:18px; align-items:center; }
  .archive-row:hover { background:var(--panel-alt); }
  .archive-row b { color:var(--blue); }
  .archive-row small { color:var(--text-muted); font-size:13px; line-height:1.5; }
  .archive-link { color:var(--green); font-size:13px; font-weight:700; white-space:nowrap; }
</style>

