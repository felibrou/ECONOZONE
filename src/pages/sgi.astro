const optionLabel = (sgi) => {
  if (typeof sgi.courtage !== 'number') return `${sgi.name} — tarif non communiqué`;
  if (sgi.id === 'coris') return `${sgi.name} — coût observé 1,22 % par opération`;
  return `${sgi.name} — courtage indicatif ${sgi.courtage.toLocaleString('fr-FR')} %`;
};
---
<Layout title="ECONOZONE — Comparatif des SGI agréées auprès de la BRVM">

    <div class="breadcrumb">ECONOZONE &rsaquo; Bourse &rsaquo; SGI</div>
    <h1>Comparatif des SGI agréées auprès de la BRVM</h1>
    <p class="dek">Une SGI (Société de Gestion et d'Intermédiation) est l'intermédiaire obligatoire pour tout ordre d'achat ou de vente sur la BRVM. Ses tarifs sont libres mais homologués par l'AMF-UMOA — ce qui n'empêche pas des écarts significatifs entre courtiers, sur les frais comme sur les conditions d'accès.</p>

    <div class="note">&#9888; Données indicatives issues de sources publiques (BRVM, Sikafinance, AMF-UMOA — anciennement CREPMF). Toutes les SGI citées sont agréées par l'AMF-UMOA — vérifiez toujours les tarifs directement auprès de chaque SGI avant ouverture de compte.</div>
    <p style="font-size:12px; color:var(--label); margin-top:-10px;">Dernière vérification des homologations AMF-UMOA : septembre 2026 (BICI Bourse : déc. 2024 · BOA Capital Securities : fév. 2024 · Atlantique Finance : 2024 · Coris Bourse : 29 janv. 2018 (décision CREPMF PCR/DA/2018/052, document officiel) · FGI : mars 2025 — aucune décision plus récente retrouvée à cette date).</p>
    <p style="font-size:12px; color:var(--label); margin-top:6px;"><b style="color:var(--navy);">ECONOZONE n'est affilié à aucune des SGI listées ci-dessous et ne perçoit aucune commission sur l'ouverture d'un compte.</b> Sauf indication contraire, les données proviennent de la grille tarifaire officielle homologuée de chaque SGI ; celles fondées sur des relevés de transactions réels ou une confirmation directe sont signalées comme telles.</p>


    <p class="dek" style="margin-top:-8px;">Trois outils pour comparer les SGI de la BRVM : calculez d'abord le coût exact d'un ordre précis, simulez ensuite l'impact du courtage sur plusieurs années, puis consultez le détail complet des frais et conditions de chaque SGI.</p>

    <h2 id="calculatrice-ordre">1 — Calculatrice d'ordre BRVM : combien coûte réellement mon achat ou ma vente ?</h2>
    <p>La calculatrice répond à une question immédiate : <b>pour cet ordre précis, combien vais-je payer à l'achat ou recevoir net à la vente ?</b> Elle distingue le montant brut, le courtage de la SGI, les commissions BRVM et DC/BR ainsi que la taxe éventuellement observée sur le relevé.</p>
    <div id="op-sim-box" class="tool-panel">
      <div style="display:flex; gap:16px; flex-wrap:wrap; margin-bottom:16px;">
        <label style="font-size:13px; color:var(--text-muted);">Type d'opération<br>
          <select id="op-type" style="margin-top:4px; padding:6px 10px; border:1px solid var(--border); font-family:inherit;">
            <option value="achat">Achat</option>
            <option value="vente">Vente</option>
          </select>
        </label>
        <label style="font-size:13px; color:var(--text-muted);">Cours de l'action (FCFA)<br>
          <input id="op-cours" type="number" value="12000" step="5" style="margin-top:4px; padding:6px 10px; border:1px solid var(--border); width:140px; font-family:inherit;">
        </label>
        <label style="font-size:13px; color:var(--text-muted);">Nombre de titres<br>
          <input id="op-qte" type="number" value="10" min="1" style="margin-top:4px; padding:6px 10px; border:1px solid var(--border); width:100px; font-family:inherit;">
        </label>
        <label style="font-size:13px; color:var(--text-muted);">SGI<br>
          <select id="op-sgi" style="margin-top:4px; padding:6px 10px; border:1px solid var(--border); font-family:inherit;">
            {sgiOptions.map((sgi) => (
              <option
                value={sgi.id}
                selected={sgi.id === 'coris'}
                data-name={sgi.name}
                data-courtage={sgi.courtage ?? ''}
                data-brvm={sgi.brvm ?? ''}
                data-dcbr={sgi.dcbr ?? ''}
                data-taf={sgi.taf ?? ''}
              >{optionLabel(sgi)}</option>
            ))}
          </select>
        </label>
      </div>
      <table class="z" style="margin:0;">
        <tbody>
          <tr><td>Montant brut (cours &times; titres)</td><td id="op-brut" style="text-align:right; font-weight:600;">—</td></tr>
          <tr><td>Commission de courtage SGI</td><td id="op-courtage" style="text-align:right;">—</td></tr>
          <tr><td>Commission BRVM</td><td id="op-brvm" style="text-align:right;">—</td></tr>
          <tr><td>Commission DC/BR</td><td id="op-dcbr" style="text-align:right;">—</td></tr>
          <tr><td>TAF sur le courtage</td><td id="op-taf" style="text-align:right;">—</td></tr>
          <tr id="op-total-row" style="border-top:2px solid var(--navy);"><td id="op-total-label" style="font-weight:700; color:var(--navy);">Montant total à payer</td><td id="op-total" style="text-align:right; font-weight:700; color:var(--navy);">—</td></tr>
        </tbody>
      </table>
      <p id="op-rate-note" style="font-size:11px; color:var(--label); margin:10px 0 0;">Pour Coris Bourse, le calcul reproduit la grille et le relevé transmis : courtage 0,80 %, BRVM 0,20 %, DC/BR 0,10 % et TAF de 14,85 % appliquée au seul courtage. Chaque ligne est arrondie au FCFA, comme sur le bordereau.</p>
    </div>
    <script>
      function ecoOpSimUpdate() {
        var type = document.getElementById('op-type').value;
        var cours = parseFloat(document.getElementById('op-cours').value) || 0;
        var qte = parseFloat(document.getElementById('op-qte').value) || 0;
        var select = document.getElementById('op-sgi');
        var option = select.options[select.selectedIndex];
        var courtageRate = parseFloat(option.dataset.courtage);
        var brvmRate = parseFloat(option.dataset.brvm);
        var dcbrRate = parseFloat(option.dataset.dcbr);
        var tafRate = parseFloat(option.dataset.taf);
        var brut = cours * qte;
        var hasTariff = Number.isFinite(courtageRate);

        function roundedFee(rate) {
          return Number.isFinite(rate) ? Math.round(brut * rate / 100) : 0;
        }

        var courtage = roundedFee(courtageRate);
        var brvm = roundedFee(brvmRate);
        var dcbr = roundedFee(dcbrRate);
        var taf = Number.isFinite(tafRate) ? Math.round(courtage * tafRate / 100) : 0;
        var fees = courtage + brvm + dcbr + taf;
        var total = type === 'achat' ? (brut + fees) : (brut - fees);

        function fmt(n) { return Math.round(n).toLocaleString('fr-FR') + ' FCFA'; }
        document.getElementById('op-brut').textContent = fmt(brut);
        document.getElementById('op-courtage').textContent = hasTariff ? fmt(courtage) : 'Tarif non communiqué';
        document.getElementById('op-brvm').textContent = hasTariff ? fmt(brvm) : '—';
        document.getElementById('op-dcbr').textContent = hasTariff ? fmt(dcbr) : '—';
        document.getElementById('op-taf').textContent = hasTariff ? fmt(taf) : '—';
        document.getElementById('op-total').textContent = hasTariff ? fmt(total) : 'Calcul indisponible';
        document.getElementById('op-total-label').textContent = type === 'achat' ? 'Montant total à payer' : 'Montant net à recevoir';
        document.getElementById('op-rate-note').textContent = option.value === 'coris'
          ? 'Pour Coris Bourse, le calcul reproduit la grille et le relevé transmis : courtage 0,80 %, BRVM 0,20 %, DC/BR 0,10 % et TAF de 14,85 % appliquée au seul courtage. Chaque ligne est arrondie au FCFA, comme sur le bordereau.'
          : hasTariff
            ? 'Estimation fondée sur le milieu de la fourchette de courtage disponible, auquel s’ajoutent 0,20 % de commission BRVM et 0,10 % de commission DC/BR. Le contrat individuel peut prévoir un tarif différent.'
            : 'Cette SGI figure bien dans l’annuaire, mais aucun tarif suffisamment fiable n’est disponible pour produire une estimation. Demandez sa grille homologuée avant toute comparaison.';
      }
      ['op-type', 'op-cours', 'op-qte', 'op-sgi'].forEach(function (id) {
        document.getElementById(id).addEventListener('input', ecoOpSimUpdate);
        document.getElementById(id).addEventListener('change', ecoOpSimUpdate);
      });
      ecoOpSimUpdate();
    </script>

    <h2 id="simulateur">2 — Simulateur : combien vous coûtent vraiment les frais de courtage ?</h2>
    <p>Un écart de 0,5 point de courtage semble minime sur une seule opération. Répété sur plusieurs années, il devient un vrai montant en FCFA — sélectionnez 2 à 4 SGI pour comparer leur coût cumulé côte à côte.</p>
    <div id="sim-box" class="tool-panel">
      <div style="display:flex; gap:16px; flex-wrap:wrap; margin-bottom:18px;">
        <label style="font-size:13px; color:var(--text-muted);">Budget investi (FCFA)<br>
          <input id="sim-budget" type="number" value="500000" step="10000" style="margin-top:4px; padding:6px 10px; border:1px solid var(--border); width:160px; font-family:inherit;">
        </label>
        <label style="font-size:13px; color:var(--text-muted);">Opérations par an<br>
          <input id="sim-ops" type="number" value="4" min="1" style="margin-top:4px; padding:6px 10px; border:1px solid var(--border); width:100px; font-family:inherit;">
        </label>
      </div>

      <div style="font-size:11px; font-weight:700; letter-spacing:0.5px; color:var(--label); text-transform:uppercase; margin-bottom:8px;">Comparer 2 à 4 SGI</div>
      <div class="sim-select-grid">
        {[1, 2, 3, 4].map((slot) => (
          <select class="sim-sgi-select" data-slot={slot}>
            <option value="" selected={slot > 2}>— Aucune —</option>
            {sgiOptions.map((sgi) => (
              <option
                value={sgi.id}
                selected={(slot === 1 && sgi.id === 'bici') || (slot === 2 && sgi.id === 'coris')}
                data-name={sgi.name}
                data-courtage={sgi.courtage ?? ''}
                data-brvm={sgi.brvm ?? ''}
                data-dcbr={sgi.dcbr ?? ''}
                data-taf={sgi.taf ?? ''}
              >{optionLabel(sgi)}</option>
            ))}
          </select>
        ))}
      </div>

      <table class="z" style="margin:16px 0 0;">
        <thead><tr><th>SGI</th><th>1 an</th><th>3 ans</th><th>5 ans</th></tr></thead>
        <tbody id="sim-results">
          <tr><td colspan="4" style="color:var(--label); font-style:italic;">Sélectionnez au moins une SGI ci-dessus.</td></tr>
        </tbody>
      </table>
      <p style="font-size:11px; color:var(--label); margin:10px 0 0;">Le coût cumulé inclut le courtage et les commissions BRVM/DC-BR à chaque opération. Pour Coris Bourse, il inclut aussi la TAF de 14,85 % appliquée au courtage. Les SGI dont le tarif n'est pas communiqué restent visibles dans la liste, mais aucun montant n'est inventé.</p>
    </div>
    <style>
      .sim-select-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(190px, 1fr)); gap: 10px; }
      .sim-select-grid select { padding: 7px 10px; border: 1px solid var(--border); font-family: inherit; font-size: 13px; width: 100%; }
      #sim-results tr.sim-best td { font-weight: 700; color: var(--up); }
    </style>
    <script>
      function ecoSimUpdate() {
        var budget = parseFloat(document.getElementById('sim-budget').value) || 0;
        var ops = parseFloat(document.getElementById('sim-ops').value) || 0;
        var selects = document.querySelectorAll('.sim-sgi-select');
        var rows = [];

        selects.forEach(function (sel) {
          if (!sel.value) return;
          var opt = sel.options[sel.selectedIndex];
          var name = opt.getAttribute('data-name');
          var courtageRate = parseFloat(opt.dataset.courtage);
          var brvmRate = parseFloat(opt.dataset.brvm);
          var dcbrRate = parseFloat(opt.dataset.dcbr);
          var tafRate = parseFloat(opt.dataset.taf);
          var hasTariff = Number.isFinite(courtageRate);
          var effectiveTafRate = Number.isFinite(tafRate) ? courtageRate * tafRate / 100 : 0;
          var totalRate = hasTariff
            ? (courtageRate + (Number.isFinite(brvmRate) ? brvmRate : 0) + (Number.isFinite(dcbrRate) ? dcbrRate : 0) + effectiveTafRate) / 100
            : null;
          var annual = hasTariff ? budget * totalRate * ops : null;
          rows.push({ name: name, y1: annual, y3: annual === null ? null : annual * 3, y5: annual === null ? null : annual * 5 });
        });

        function fmt(n) { return Math.round(n).toLocaleString('fr-FR') + ' FCFA'; }
        var tbody = document.getElementById('sim-results');

        if (rows.length === 0) {
          tbody.innerHTML = '<tr><td colspan="4" style="color:var(--label); font-style:italic;">Sélectionnez au moins une SGI ci-dessus.</td></tr>';
          return;
        }

        var comparable = rows.filter(function (r) { return r.y5 !== null; });
        var minY5 = comparable.length ? Math.min.apply(null, comparable.map(function (r) { return r.y5; })) : null;
        tbody.innerHTML = rows.map(function (r) {
          var cls = (comparable.length > 1 && r.y5 === minY5) ? ' class="sim-best"' : '';
          var unavailable = '<span style="color:var(--label)">Tarif non communiqué</span>';
          return '<tr' + cls + '><td>' + r.name + '</td><td>' + (r.y1 === null ? unavailable : fmt(r.y1)) + '</td><td>' + (r.y3 === null ? '—' : fmt(r.y3)) + '</td><td>' + (r.y5 === null ? '—' : fmt(r.y5)) + '</td></tr>';
        }).join('');
      }
      document.getElementById('sim-budget').addEventListener('input', ecoSimUpdate);
      document.getElementById('sim-ops').addEventListener('input', ecoSimUpdate);
      document.querySelectorAll('.sim-sgi-select').forEach(function (sel) {
        sel.addEventListener('change', ecoSimUpdate);
      });
      ecoSimUpdate();
    </script>

    <p style="font-size:12px; color:var(--label); margin-top:-2px;">* Coris Bourse : les 50 000 FCFA constituent un dépôt initial et non un frais. Le calculateur utilise les composantes visibles sur la grille et le relevé transmis : courtage 0,80 %, commission BRVM 0,20 %, commission DC/BR 0,10 % et TAF de 14,85 % appliquée au courtage.</p>

    <h2 id="tableau-frais">3 — Frais et conditions d'accès</h2>

    <div id="contact-counter" class="counter-badge">📊 <span id="counter-value">…</span> clics vers les sites des SGI enregistrés depuis ECONOZONE</div>
    <p class="directory-note">Annuaire affiché : <strong>37 SGI agréées recensées par la BRVM</strong>, auxquelles s'ajoute Daba Finance comme plateforme d'accès non agréée directement en qualité de SGI.</p>

    <div class="filter-bar">
      <div class="filter-group">
        <span class="filter-label">Pays</span>
        <button class="chip active" data-filter-type="country" data-filter-value="all">🌍 Tous</button>
        <button class="chip" data-filter-type="country" data-filter-value="CI">🇨🇮 Côte d'Ivoire</button>
        <button class="chip" data-filter-type="country" data-filter-value="BF">🇧🇫 Burkina Faso</button>
        <button class="chip" data-filter-type="country" data-filter-value="SN">🇸🇳 Sénégal</button>
        <button class="chip" data-filter-type="country" data-filter-value="TG">🇹🇬 Togo</button>
        <button class="chip" data-filter-type="country" data-filter-value="ML">🇲🇱 Mali</button>
        <button class="chip" data-filter-type="country" data-filter-value="BJ">🇧🇯 Bénin</button>
        <button class="chip" data-filter-type="country" data-filter-value="NE">🇳🇪 Niger</button>
      </div>
      <div class="filter-group">
        <span class="filter-label">Critères</span>
        <button class="chip toggle" data-filter-type="online">💻 Accès digital confirmé</button>
        <button class="chip toggle" data-filter-type="lowdeposit">💰 Dépôt &lt; 300 000 FCFA</button>
        <button class="chip toggle" data-filter-type="mandat">🎓 Gestion sous mandat proposée</button>
      </div>
    </div>
    <p id="filter-count" style="font-size:12px; color:var(--label); margin:10px 0 0;"></p>

    <div class="sgi-grid">

      <div class="sgi-card" data-country="CI" data-lowdeposit="1" data-online="0" data-mandat="0">
        <div class="sgi-card-top">
          <span class="badge-rank">#1 capitalisation groupe</span>
          <span class="flag">🇨🇮</span>
        </div>
        <h3>BICIBourse</h3>
        <p class="sgi-group">BICICI (consortium ivoirien depuis 2022)</p>
        <div class="sgi-stats">
          <div><span>Dépôt min.</span><b>Aucun (200k conseillé)</b></div>
          <div><span>Courtage</span><b>0,4 % – 1 %</b></div>
          <div><span>Conservation</span><b>0,1 – 0,5 %/an</b></div>
          <div><span>Gestion mandat</span><b>Non proposé</b></div>
        </div>
        <a href="https://www.bicici.com/professionnels/epargne-placements/investir-en-bourse/bicici-bourse/" target="_blank" class="sgi-link contact-click">Site officiel &#8599;</a>
      </div>

      <div class="sgi-card" data-country="BF" data-lowdeposit="1" data-online="1" data-mandat="1">
        <div class="sgi-card-top"><span class="flag">🇧🇫</span></div>
        <h3>Coris Bourse</h3>
        <p class="sgi-group">Groupe Coris (Coris Bank International)</p>
        <div class="sgi-stats">
          <div><span>Dépôt min.</span><b>50 000 FCFA*</b></div>
          <div><span>Courtage</span><b>0,80 %*</b></div>
          <div><span>Commission BRVM</span><b>0,20 %*</b></div>
          <div><span>Commission DC/BR</span><b>0,10 %*</b></div>
        </div>
        <div class="sgi-stats">
          <div><span>TAF sur courtage</span><b>14,85 %*</b></div>
          <div><span>Coût effectif estimé</span><b>≈ 1,22 %*</b></div>
        </div>
        <p style="font-size:11px; color:var(--label); margin:4px 0 0;">Le courtage et les commissions BRVM/DC-BR sont calculés sur le montant brut. La TAF est ensuite calculée sur le courtage : pour 12 600 FCFA, le relevé affiche 101 FCFA de courtage, 25 FCFA de commission BRVM, 13 FCFA de commission DC/BR et 15 FCFA de taxe.</p>
        <a href="https://www.coris-bourse.com/" target="_blank" class="sgi-link contact-click">Site officiel &#8599;</a>
      </div>

      <div class="sgi-card" data-country="SN" data-lowdeposit="1" data-online="0" data-mandat="0">
        <div class="sgi-card-top"><span class="flag">🇸🇳</span></div>
        <h3>CGF Bourse</h3>
        <p class="sgi-group">Indépendant — 1ʳᵉ SGI agréée AMF-UMOA</p>
        <div class="sgi-stats">
          <div><span>Dépôt min.</span><b>100 000 FCFA*</b></div>
          <div><span>Courtage</span><b>1 % – 1,5 %*</b></div>
          <div><span>Conservation</span><b>Non communiqué</b></div>
          <div><span>Gestion mandat</span><b>Sur devis</b></div>
        </div>
        <a href="https://www.cgfbourse.com/" target="_blank" class="sgi-link contact-click">Site officiel &#8599;</a>
      </div>

      <div class="sgi-card" data-country="TG" data-lowdeposit="1" data-online="1" data-mandat="1">
        <div class="sgi-card-top"><span class="flag">🇹🇬</span></div>
        <h3>SGI Togo</h3>
        <p class="sgi-group">Ouverture 100 % à distance confirmée</p>
        <div class="sgi-stats">
          <div><span>Dépôt min.</span><b>160 000 FCFA*</b></div>
          <div><span>Courtage</span><b>1,15 % – 1,3 %*</b></div>
          <div><span>Conservation</span><b>0,095 %/trim.</b></div>
          <div><span>Gestion mandat</span><b>0,2 %/trim.</b></div>
        </div>
        <a href="https://www.sgitogo.com/" target="_blank" class="sgi-link contact-click">Site officiel &#8599;</a>
      </div>

      <div class="sgi-card" data-country="CI" data-lowdeposit="1" data-online="0" data-mandat="1">
        <div class="sgi-card-top"><span class="flag">🇨🇮</span></div>
        <h3>NSIA Finance</h3>
