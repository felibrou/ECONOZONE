</style>


<script>

  /* ======================================================== */
  /* CALCULATRICE                                             */
  /* ======================================================== */

  function updateOrderCalculator() {

    const type =
      document.getElementById('op-type').value;

    const cours =
      parseFloat(
        document.getElementById('op-cours').value
      ) || 0;

    const qte =
      parseFloat(
        document.getElementById('op-qte').value
      ) || 0;

    const select =
      document.getElementById('op-sgi');

    const option =
      select.options[select.selectedIndex];


    const courtageRate =
      parseFloat(option.dataset.courtage);

    const brvmRate =
      parseFloat(option.dataset.brvm);

    const dcbrRate =
      parseFloat(option.dataset.dcbr);

    const tafRate =
      parseFloat(option.dataset.taf);


    const brut =
      cours * qte;


    const hasTariff =
      Number.isFinite(courtageRate);


    const fee = (rate) =>
      Number.isFinite(rate)
        ? Math.round(brut * rate / 100)
        : 0;


    const courtage =
      fee(courtageRate);

    const brvm =
      fee(brvmRate);

    const dcbr =
      fee(dcbrRate);

    const taf =
      Number.isFinite(tafRate)
        ? Math.round(
            courtage *
            tafRate /
            100
          )
        : 0;


    const totalFees =
      courtage +
      brvm +
      dcbr +
      taf;


    const total =
      type === 'achat'
        ? brut + totalFees
        : brut - totalFees;


    const formatFcfa = (value) =>
      Math.round(value)
        .toLocaleString('fr-FR') +
      ' FCFA';


    document
      .getElementById('op-brut')
      .textContent =
        formatFcfa(brut);


    document
      .getElementById('op-courtage')
      .textContent =
        hasTariff
          ? formatFcfa(courtage)
          : 'Tarif non communiqué';


    document
      .getElementById('op-brvm')
      .textContent =
        hasTariff
          ? formatFcfa(brvm)
          : '—';


    document
      .getElementById('op-dcbr')
      .textContent =
        hasTariff
          ? formatFcfa(dcbr)
          : '—';


    document
      .getElementById('op-taf')
      .textContent =
        hasTariff
          ? formatFcfa(taf)
          : '—';


    document
      .getElementById('op-total')
      .textContent =
        hasTariff
          ? formatFcfa(total)
          : 'Calcul indisponible';


    document
      .getElementById('op-total-label')
      .textContent =
        type === 'achat'
          ? 'Montant total à payer'
          : 'Montant net à recevoir';


    const note =
      document.getElementById(
        'op-rate-note'
      );


    if (option.value === 'coris') {

      note.textContent =
        'Coris Bourse : courtage 0,80 %, BRVM 0,20 %, DC/BR 0,10 % et TAF de 14,85 % appliquée au courtage.';

    } else if (hasTariff) {

      note.textContent =
        'Estimation à partir des taux actuellement renseignés dans le comparateur. Vérifiez la grille contractuelle de la SGI.';

    } else {

      note.textContent =
        'Aucun tarif suffisamment documenté pour produire une estimation fiable.';

    }

  }


  [
    'op-type',
    'op-cours',
    'op-qte',
    'op-sgi',
  ].forEach((id) => {

    const element =
      document.getElementById(id);

    element?.addEventListener(
      'input',
      updateOrderCalculator
    );

    element?.addEventListener(
      'change',
      updateOrderCalculator
    );

  });


  updateOrderCalculator();


  /* ======================================================== */
  /* SIMULATEUR                                               */
  /* ======================================================== */

  function updateSimulator() {

    const budget =
      parseFloat(
        document.getElementById(
          'sim-budget'
        ).value
      ) || 0;


    const ops =
      parseFloat(
        document.getElementById(
          'sim-ops'
        ).value
      ) || 0;


    const rows = [];


    document
      .querySelectorAll(
        '.sim-sgi-select'
      )
      .forEach((select) => {

        if (!select.value) return;


        const option =
          select.options[
            select.selectedIndex
          ];


        const courtage =
          parseFloat(
            option.dataset.courtage
          );


        const brvm =
          parseFloat(
            option.dataset.brvm
          );


        const dcbr =
          parseFloat(
            option.dataset.dcbr
          );


        const taf =
          parseFloat(
            option.dataset.taf
          );


        if (!Number.isFinite(courtage)) {

          rows.push({
            name:
              option.dataset.name,
            annual: null,
          });

          return;
        }


        const tafRate =
          Number.isFinite(taf)
            ? courtage * taf / 100
            : 0;


        const totalRate =
          (
            courtage +
            (
              Number.isFinite(brvm)
                ? brvm
                : 0
            ) +
            (
              Number.isFinite(dcbr)
                ? dcbr
                : 0
            ) +
            tafRate
          ) / 100;


        rows.push({
          name:
            option.dataset.name,

          annual:
            budget *
            totalRate *
            ops,
        });

      });


    const tbody =
      document.getElementById(
        'sim-results'
      );


    if (!rows.length) {

      tbody.innerHTML =
        '<tr><td colspan="4">Sélectionnez au moins une SGI.</td></tr>';

      return;
    }


    const valid =
      rows.filter(
        (row) =>
          row.annual !== null
      );


    const minimum =
      valid.length
        ? Math.min(
            ...valid.map(
              (row) =>
                row.annual * 5
            )
          )
        : null;


    const fcfa =
      (value) =>
        Math.round(value)
          .toLocaleString('fr-FR') +
        ' FCFA';


    tbody.innerHTML =
      rows.map((row) => {

        if (row.annual === null) {

          return `
            <tr>
              <td>${row.name}</td>
              <td colspan="3">
                Tarif non communiqué
              </td>
            </tr>
          `;

        }


        const isBest =
          valid.length > 1 &&
          row.annual * 5 === minimum;


        return `
          <tr class="${isBest ? 'sim-best' : ''}">
            <td>${row.name}</td>
            <td>${fcfa(row.annual)}</td>
            <td>${fcfa(row.annual * 3)}</td>
            <td>${fcfa(row.annual * 5)}</td>
          </tr>
        `;

      }).join('');

  }


  document
    .getElementById('sim-budget')
    ?.addEventListener(
      'input',
      updateSimulator
    );


  document
    .getElementById('sim-ops')
    ?.addEventListener(
      'input',
      updateSimulator
    );


  document
    .querySelectorAll(
      '.sim-sgi-select'
    )
    .forEach((select) => {

      select.addEventListener(
        'change',
        updateSimulator
      );

    });


  updateSimulator();


  /* ======================================================== */
  /* FILTRES                                                  */
  /* ======================================================== */

  (() => {

    const state = {
      country: 'all',
      online: false,
      lowdeposit: false,
      mandat: false,
    };


    const cards =
      document.querySelectorAll(
        '.sgi-card'
      );


    const countBox =
      document.getElementById(
        'filter-count'
      );


    function applyFilters() {

      let visible = 0;


      cards.forEach((card) => {

        const countryOk =
          state.country === 'all' ||
          card.dataset.country ===
            state.country;


        const onlineOk =
          !state.online ||
          card.dataset.online === '1';


        const depositOk =
          !state.lowdeposit ||
          card.dataset.lowdeposit === '1';


        const mandateOk =
          !state.mandat ||
          card.dataset.mandat === '1';


        const show =
          countryOk &&
          onlineOk &&
          depositOk &&
          mandateOk;


        card.style.display =
          show ? '' : 'none';


        if (show) {
          visible++;
        }

      });


      countBox.textContent =
        `${visible} intermédiaire${visible > 1 ? 's' : ''} affiché${visible > 1 ? 's' : ''} sur ${cards.length}.`;

    }


    document
      .querySelectorAll(
        '.chip[data-filter-type="country"]'
      )
      .forEach((button) => {

        button.addEventListener(
          'click',
          () => {

            document
              .querySelectorAll(
                '.chip[data-filter-type="country"]'
              )
              .forEach(
                (item) =>
                  item.classList.remove(
                    'active'
                  )
              );


            button.classList.add(
              'active'
            );


            state.country =
              button.dataset.filterValue;


            applyFilters();

          }
        );

      });


    document
      .querySelectorAll(
        '.chip.toggle'
      )
      .forEach((button) => {

        button.addEventListener(
          'click',
          () => {

            const key =
              button.dataset.filterType;


            state[key] =
              !state[key];


            button.classList.toggle(
              'active',
              state[key]
            );


            applyFilters();

          }
        );

      });


    applyFilters();

  })();


  /* ======================================================== */
  /* COMPTEUR                                                 */
  /* ======================================================== */

  const COUNTER_WORKSPACE =
    'econozone';

  const COUNTER_KEY =
    'sgi-contact-clicks';


  async function loadCount() {

    const element =
      document.getElementById(
        'counter-value'
      );


    try {

      const response =
        await fetch(
          `https://api.counterapi.dev/v2/${COUNTER_WORKSPACE}/${COUNTER_KEY}`
        );


      const data =
        await response.json();


      element.textContent =
        data?.data?.up_count ?? 0;

    } catch {

      element.textContent = '—';

    }

  }


  async function incrementCount() {

    try {

      const response =
        await fetch(
          `https://api.counterapi.dev/v2/${COUNTER_WORKSPACE}/${COUNTER_KEY}/up`
        );


      const data =
        await response.json();


      const element =
        document.getElementById(
          'counter-value'
        );


      if (element) {

        element.textContent =
          data?.data?.up_count ??
          element.textContent;

      }

    } catch {

      /* Ne jamais bloquer le lien externe. */

    }

  }


  document
    .querySelectorAll(
      '.contact-click'
    )
    .forEach((link) => {

      link.addEventListener(
        'click',
        incrementCount
      );

    });


  loadCount();


  /* ======================================================== */
  /* SÉCURITÉ DES COULEURS DES CARTES                         */
  /* ======================================================== */

  document
    .querySelectorAll(
      '.sgi-card'
    )
    .forEach((card) => {

      card.style.setProperty(
        'color',
        '#FFFFFF',
        'important'
      );


      card
        .querySelectorAll(
          'h3, p, b, strong, small'
        )
        .forEach((element) => {

          element.style.setProperty(
            'color',
            '#FFFFFF',
            'important'
          );

        });


      card
        .querySelectorAll(
          '.sgi-stat-label'
        )
        .forEach((element) => {

          element.style.setProperty(
            'color',
            '#F4C95D',
            'important'
          );

        });


      card
        .querySelectorAll(
          '.sgi-link, .sgi-contact-link'
        )
        .forEach((element) => {

          element.style.setProperty(
            'color',
            '#72D6FF',
            'important'
          );

        });

    });

</script>