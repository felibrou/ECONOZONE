const sgiOptions = cards
  .filter((x) => !x.nonSgi)
  .map((x) => ({
    id: x.id,
    name: x.name,
    courtage: x.courtage,
    brvm: x.brvm,
    dcbr: x.dcbr,
    taf: x.taf,
  }));

const optionLabel = (sgi) => {
  if (typeof sgi.courtage !== 'number') {
    return `${sgi.name} — tarif non communiqué`;
  }

  if (sgi.id === 'coris') {
    return `${sgi.name} — coût observé ≈ 1,22 %`;
  }

  return `${sgi.name} — courtage indicatif ${sgi.courtage.toLocaleString('fr-FR')} %`;
};

const telHref = (text) => {
  const cleaned = String(text || '')
    .replace(/[^\d+]/g, '');

  return cleaned ? `tel:${cleaned}` : '#';
};

const logoUrl = (domain) =>
  domain
    ? `https://www.google.com/s2/favicons?domain=${encodeURIComponent(domain)}&sz=64`
    : null;

const initials = (name) =>
  name
    .replace(/&amp;/g, '&')
    .split(/\s+/)
    .filter(Boolean)
    .slice(0, 2)
    .map((part) => part.charAt(0).toUpperCase())
    .join('');
