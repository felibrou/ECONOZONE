<script>
  // Compteur réel de demandes de contact vers les SGI — via CounterAPI.dev (gratuit, sans base de données à gérer).
  // Config requise : créer un compte gratuit sur https://app.counterapi.dev, workspace "econozone".
  const COUNTER_WORKSPACE = 'econozone';
  const COUNTER_KEY = 'sgi-contact-clicks';

  async function loadCount() {
    try {
      const res = await fetch(`https://api.counterapi.dev/v2/${COUNTER_WORKSPACE}/${COUNTER_KEY}`);
      const data = await res.json();
      document.getElementById('counter-value').textContent = (data.data && data.data.up_count) || 0;
    } catch (e) {
      document.getElementById('counter-value').textContent = '—';
    }
  }

  async function incrementCount() {
    try {
      const res = await fetch(`https://api.counterapi.dev/v2/${COUNTER_WORKSPACE}/${COUNTER_KEY}/up`);
      const data = await res.json();
      const el = document.getElementById('counter-value');
      if (el) el.textContent = (data.data && data.data.up_count) || '—';
    } catch (e) { /* échec silencieux — ne bloque jamais le clic du visiteur vers la SGI */ }
  }

  document.querySelectorAll('.contact-click').forEach(function (link) {
    link.addEventListener('click', function () { incrementCount(); });
  });

  loadCount();
</script>
