  dl.glossary dd { margin: 2px 0 0; font-size: 13px; color: var(--text-muted); line-height: 1.5; max-width: 700px; }
  .faq-item { border-bottom: 1px solid var(--row-border); padding: 14px 0; }
  .faq-q { font-weight: 700; color: var(--navy); font-size: 14px; margin: 0 0 4px; }
  .faq-a { font-size: 13px; color: var(--text-muted); line-height: 1.6; margin: 0; max-width: 720px; }
