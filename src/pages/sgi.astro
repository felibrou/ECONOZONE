  { id: 'coris', name: 'Coris Bourse', courtage: 0.80, brvm: 0.20, dcbr: 0.10, taf: 14.85, indicative: false },
  { id: 'cgf', name: 'CGF Bourse', courtage: 1.25, brvm: 0.20, dcbr: 0.10, tob: 0, indicative: true },
  { id: 'sgitogo', name: 'SGI Togo', courtage: 1.225, brvm: 0.20, dcbr: 0.10, tob: 0, indicative: true },
  { id: 'nsia', name: 'NSIA Finance', courtage: 1.25, brvm: 0.20, dcbr: 0.10, tob: 0, indicative: true },
  { id: 'sirius', name: 'Sirius Capital', courtage: 1.25, brvm: 0.20, dcbr: 0.10, tob: 0, indicative: true },
  { id: 'edc', name: 'EDC Investment Corporation', courtage: 0.70, brvm: 0.20, dcbr: 0.10, tob: 0, indicative: true },
  { id: 'sgcapital', name: 'SG Capital Securities West Africa', courtage: 0.85, brvm: 0.20, dcbr: 0.10, tob: 0, indicative: true },
  { id: 'atlantique', name: 'Atlantique Finance', courtage: 0.825, brvm: 0.20, dcbr: 0.10, tob: 0, indicative: true },
  { id: 'hudson', name: 'Hudson & Cie', courtage: 1.00, brvm: 0.20, dcbr: 0.10, tob: 0, indicative: true },
  { id: 'abco', name: 'ABCO Bourse' },
  { id: 'agi', name: "Africaine de Gestion et d'Intermédiation (AGI)" },
  { id: 'attijari', name: 'Attijari Securities West Africa' },
  { id: 'boa', name: 'BOA Capital Securities' },
  { id: 'bridge', name: 'Bridge Securities' },
  { id: 'bsic', name: 'BSIC Capital' },
  { id: 'cifa', name: 'CIFA Bourse' },
  { id: 'everest', name: 'Everest Finance' },
  { id: 'fgi', name: 'FGI — Finance Gestion Intermédiation' },
  { id: 'gek', name: 'GEK Capital' },
  { id: 'global', name: 'Global Capital' },
  { id: 'sa2if', name: 'SA2IF' },
  { id: 'image', name: 'Image Finances Internationales' },
  { id: 'invictus', name: 'Invictus Capital & Finance' },
  { id: 'matha', name: 'Matha Securities' },
  { id: 'oragroup', name: 'Oragroup Securities' },
  { id: 'phoenix', name: 'Phoenix Capital Management' },
  { id: 'africabourse', name: 'SGI Africabourse' },
  { id: 'sgibenin', name: 'SGI Bénin S.A.' },
  { id: 'biic', name: 'SGI BIIC Financial Services' },
  { id: 'bni', name: 'SGI BNI Finances' },
  { id: 'impaxis', name: 'Impaxis Securities' },
  { id: 'mac', name: 'Mac African' },
  { id: 'sgimali', name: 'SGI Mali S.A.' },
