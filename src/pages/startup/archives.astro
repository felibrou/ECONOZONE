---
import Layout from '../../layouts/Layout.astro';

const editions = [
 { date: '2026-10-09', label: '9 octobre 2026 — mi-journée', title: "Airtel Money entre en Bourse à Londres", href: '/startup/2026-10-09-midi' },
 { date: '2026-10-08', label: '8 octobre 2026 — mi-journée', title: "Nigeria : Bujeti automatise la gestion financière", href: '/startup/2026-10-08-midi' },
 { date: '2026-10-07', label: '7 octobre 2026 — mi-journée', title: "Nigeria : Ororo Waste finance la collecte d’huile usagée", href: '/startup/2026-10-07-midi' },
 { date: '2026-10-06', label: '6 octobre 2026 — mi-journée', title: 'Les lauréats des ECOWAS Startup Awards', href: '/startup/2026-10-06' },
  { date: '2026-10-05', label: '5 octobre 2026 — clôture', title: 'REGIS-WA : données énergétiques et innovation régionale', href: '/startup/2026-10-05-cloture' },
  { date: '2026-10-05', label: '5 octobre 2026', title: 'Visa élargit son accélérateur au Niger et au Togo', href: '/startup/2026-10-05' },
  { date: '2026-10-04', label: '4 octobre 2026', title: 'HubPharm remporte les ECOWAS Startup Awards', href: '/startup/2026-10-04' },
  { date: '2026-10-01', label: '1er octobre 2026', title: 'Djamo, Julaya et Wave : la concurrence dans les paiements interopérables', href: '/startup/2026-10-01' },
  { date: '2026-09-30', label: '30 septembre 2026', title: 'À Abuja, 60 start-up accèdent à six mois d’accompagnement', href: '/startup/2026-09-30' },
  { date: '2026-09-29', label: '29 septembre 2026', title: 'La CEDEAO réunit 60 start-up à Abuja', href: '/startup/2026-09-29' },

  { date: '2026-09-25', label: '25 septembre 2026', title: 'Grey, Complete Farmer et financements technologiques en Afrique de l’Ouest', href: '/startup/2026-09-25' },
  { date: '2026-09-24', label: '24 septembre 2026', title: 'ECOWAS Startup Awards, Village Capital et Ventures Platform', href: '/startup/2026-09-24' },
];
---
<Layout title="ECONOZONE — Archives Start-up">
  <div class="breadcrumb">ECONOZONE &rsaquo; Start-up &rsaquo; Archives</div>
  <h1>Archives Start-up</h1>
  <p class="dek">Analyses datées sur les start-up, le capital-risque, l’innovation et les infrastructures technologiques en Afrique de l’Ouest.</p>
  <div class="archive-list">
    {editions.map(e => (
      <a class="archive-row" href={e.href}>
        <span><b>{e.label}</b><br /><small>{e.title}</small></span>
        <span class="archive-link">Lire →</span>
      </a>
    ))}
  </div>
</Layout>
<style>
  .archive-list { display:flex; flex-direction:column; gap:1px; background:var(--border); border:1px solid var(--border); margin-top:20px; }
  .archive-row { background:var(--panel); padding:16px 18px; display:flex; justify-content:space-between; gap:18px; align-items:center; }
  .archive-row:hover { background:var(--panel-alt); }
  .archive-row b { color:var(--blue); }
  .archive-row small { color:var(--text-muted); font-size:13px; line-height:1.5; }
  .archive-link { color:var(--green); font-size:13px; font-weight:700; white-space:nowrap; }
</style>


