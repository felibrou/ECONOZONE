---
export interface Props {
  title: string;
  description?: string;
}
const {
  title,
  description = "ECONOZONE décrypte la BRVM, l'économie ouest-africaine, les marchés et les politiques publiques avec rigueur et pédagogie."
} = Astro.props;
const canonicalURL = Astro.site ? new URL(Astro.url.pathname, Astro.site) : Astro.url;
import Analytics from '@vercel/analytics/astro';
---
<!doctype html>
<html lang="fr">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{title}</title>
  <meta name="description" content={description}>
  <link rel="canonical" href={canonicalURL}>
  <meta property="og:type" content="website">
  <meta property="og:locale" content="fr_FR">
  <meta property="og:site_name" content="ECONOZONE">
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:url" content={canonicalURL}>
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content={title}>
  <meta name="twitter:description" content={description}>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Source+Serif+4:opsz,wght@8..60,400;8..60,500;8..60,600;8..60,700;8..60,800&family=IBM+Plex+Sans:wght@400;500;600;700;800&display=swap">
  <style is:global>
    :root {
      --bg: #FFFFFF; --panel: #FFFFFF; --panel-alt: #F4F7FB; --border: #D9E0EA; --row-border: #EEF2F7;
      --blue: #003DA5; --blue-dark: #00286E; --green: #00843D; --green-dark: #005E2B;
      --navy: #003DA5; --text: #10182B; --text-muted: #3D4759; --label: #64708A;
      --accent: #00843D; --up: #00843D; --down: #C0392B;
    }
    * { box-sizing: border-box; }
    body { margin: 0; background: var(--bg); color: var(--text); font-family: 'IBM Plex Sans', system-ui, sans-serif; font-size: 16px; }
    a { color: inherit; text-decoration: none; }
    .wrap { width: 100%; min-height: 100vh; display: flex; flex-direction: column; align-items: center; }

    .topstripe { width: 100%; height: 6px; background: linear-gradient(90deg, var(--green) 0%, var(--green) 50%, var(--blue) 50%, var(--blue) 100%); }
    .topbar { width: 100%; background: var(--blue); box-shadow: 0 2px 8px rgba(0,61,165,0.15); }
    .topbar-inner { max-width: 1080px; margin: 0 auto; padding: 20px 24px; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 14px; }
    .brand { color: #fff; font-family: 'Source Serif 4', Georgia, serif; font-weight: 800; font-size: 24px; letter-spacing: 0.3px; }
    .brand .dot { color: var(--green); }
    nav { display: flex; gap: 22px; flex-wrap: wrap; align-items: center; }
    nav a { color: #DCE6F7; font-size: 14px; font-weight: 600; padding: 6px 2px; border-bottom: 2px solid transparent; transition: all .15s; }
    nav a:hover { color: #fff; border-bottom-color: var(--green); }
    .nav-home { display: flex; align-items: center; }
    .nav-home svg { width: 18px; height: 18px; }
    .nav-dropdown { position: relative; }
    .nav-dropdown-trigger { background: none; border: none; color: #DCE6F7; font-size: 14px; font-weight: 600; font-family: 'IBM Plex Sans'; cursor: pointer; padding: 6px 2px; display: flex; align-items: center; gap: 4px; border-bottom: 2px solid transparent; }
    .nav-dropdown-trigger:hover, .nav-dropdown.open .nav-dropdown-trigger { color: #fff; border-bottom-color: var(--green); }
    .nav-dropdown .caret { font-size: 10px; }
    .nav-dropdown-menu { display: none; position: absolute; top: 100%; left: 0; margin-top: 12px; background: #fff; border: 1px solid var(--border); border-top: 3px solid var(--green); min-width: 210px; padding: 8px 0; z-index: 20; box-shadow: 0 8px 24px rgba(0,20,60,0.15); }
    .nav-dropdown-menu a { display: block; padding: 10px 16px; font-size: 14px; color: var(--text); font-weight: 500; border-bottom: none; }
    .nav-dropdown-menu a:hover { color: var(--blue); background: var(--panel-alt); }
    .nav-dropdown:hover .nav-dropdown-menu, .nav-dropdown.open .nav-dropdown-menu { display: block; }
    @media (hover: none) { .nav-dropdown:hover .nav-dropdown-menu { display: none; } }

    .col { width: 100%; max-width: 1080px; padding: 36px 24px 90px; }
    .breadcrumb { font-size: 13px; color: var(--label); margin-bottom: 16px; font-weight: 500; }
    h1 { font-family: 'Source Serif 4', Georgia, serif; font-size: 38px; font-weight: 700; color: var(--blue); margin: 0 0 10px; letter-spacing: -0.01em; line-height: 1.15; }
    h2 { font-family: 'Source Serif 4', Georgia, serif; font-size: 24px; font-weight: 700; color: var(--blue); margin: 44px 0 10px; padding-top: 20px; border-top: 3px solid var(--panel-alt); scroll-margin-top: 20px; }
    h3 { font-size: 18px; font-weight: 700; color: var(--blue-dark); margin: 22px 0 8px; letter-spacing: -0.005em; }
    p { font-size: 16px; line-height: 1.7; color: var(--text-muted); max-width: 740px; margin: 0 0 14px; }
    .dek { font-size: 17px; color: var(--text-muted); max-width: 740px; margin: 0 0 26px; line-height: 1.65; }
    table.z { width: 100%; border-collapse: collapse; border: 1px solid var(--border); background: #FFFFFF; font-size: 14px; margin: 18px 0; }
    table.z th { background: var(--panel-alt); text-align: left; padding: 11px 15px; font-size: 12px; font-weight: 700; letter-spacing: 0.4px; color: var(--blue-dark); text-transform: uppercase; border-bottom: 2px solid var(--border); }
    table.z td { padding: 11px 15px; border-bottom: 1px solid var(--row-border); }
    /* Les nombres et leur signe % restent toujours sur la même ligne. */
    .up, .down, .flat {
      white-space: nowrap;
      font-variant-numeric: tabular-nums;
    }
    td.numeric-percent {
      text-align: right !important;
      white-space: nowrap !important;
      font-variant-numeric: tabular-nums;
    }
    th.numeric-percent-header {
      text-align: right !important;
      white-space: nowrap !important;
    }
    .note { background: var(--panel-alt); border-left: 4px solid var(--blue); padding: 16px 18px; font-size: 14px; color: var(--text-muted); margin: 18px 0; }
    .note b { color: var(--blue); }
    .disclaimer { margin-top: 52px; padding-top: 22px; border-top: 1px solid var(--border); font-size: 12px; color: var(--label); }
    .page-meta { font-size: 13px; color: var(--label); margin: -8px 0 22px; display: flex; gap: 16px; flex-wrap: wrap; }
    .page-meta b { color: var(--text-muted); font-weight: 600; }

    /* Renforce les photographies éditoriales sans modifier les graphiques ni les logos. */
    figure img:not([role="img"]) {
      filter: contrast(1.12) saturate(1.16) brightness(0.98);
      box-shadow: 0 10px 28px rgba(16, 24, 43, 0.12);
    }

    /* Les grandes images de une reçoivent un traitement plus affirmé :
       noirs plus profonds et couleurs plus présentes, sans toucher aux graphiques. */
    .hero-photo img:not([role="img"]) {
      filter: contrast(1.20) saturate(1.26) brightness(0.96);
    }

    footer.site-footer { width: 100%; background: #17243A; border-top: 4px solid var(--green); margin-top: 40px; }
    .footer-inner { max-width: 1080px; margin: 0 auto; padding: 32px 24px; }
    footer.site-footer p { font-size: 12px; color: #D7DFEC; }
    .social-row { display: flex; align-items: center; gap: 16px; margin-bottom: 16px; font-size: 13px; color: #D7DFEC; font-weight: 500; }
    .social-row a { font-weight: 700; color: #FFFFFF; }
    .social-row a:hover { text-decoration: underline; }
    .footer-links { margin-top: 4px; display: flex; gap: 14px; flex-wrap: wrap; }
    .footer-links a { font-size: 12px; color: #D7DFEC; text-decoration: underline; text-underline-offset: 2px; }
    .footer-links a:hover { color: #FFFFFF; }
  </style>
</head>
<body>
<div class="wrap">
  <div class="topstripe"></div>
  <div class="topbar">
    <div class="topbar-inner">
      <a href="/"><div class="brand">ECONOZONE<span class="dot">.</span></div></a>
      <nav>
        <a href="/" class="nav-home" aria-label="Accueil">
          <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M3 11.5L12 4l9 7.5M5.5 10v9a1 1 0 0 0 1 1H10v-5.5a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1V20h3.5a1 1 0 0 0 1-1v-9" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
        <a href="/essentiel">Actualités</a>
        <div class="nav-dropdown">
          <button class="nav-dropdown-trigger" aria-expanded="false">BRVM <span class="caret">&#9662;</span></button>
          <div class="nav-dropdown-menu">
            <a href="/societes-cotees">Sociétés cotées</a>
            <a href="/sgi">SGI</a>
            <a href="/comprendre-la-bourse">Comprendre la Bourse</a>
          </div>
        </div>
        <a href="/economie">Économie</a>
        <a href="/matieres-premieres">Matières premières</a>
        <a href="/startup">Start-up</a>
        <a href="/carrieres">Carrières</a>
        <a href="/a-propos">À propos</a>
      </nav>
    </div>
  </div>
  <div class="col">
    <slot />
  </div>
  <footer class="site-footer">
    <div class="footer-inner">
      <div class="social-row">
        <span>La rédaction</span>
        <a href="mailto:contact@econozone.org">contact@econozone.org</a>
      </div>
      <p>ECONOZONE — contenu publié à des fins purement informatives, ne constitue pas un conseil en investissement.</p>
      <p>&copy; {new Date().getFullYear()} ECONOZONE. Tous droits réservés. Toute reproduction ou réutilisation du contenu, en tout ou en partie, sans autorisation écrite préalable, est interdite.</p>
      <p class="footer-links"><a href="/politique-cookies">Politique relative aux cookies</a><a href="/desabonnement">Se désabonner de nos communications</a></p>
    </div>
  </footer>
  <Analytics />
  <script>
    document.querySelectorAll('table').forEach(function (table) {
      const percentColumns = new Set();

      table.querySelectorAll('tbody tr').forEach(function (row) {
        Array.from(row.children).forEach(function (cell, index) {
          const value = (cell.textContent || '').replace(/\s+/g, ' ').trim();
          const beginsWithNumber = /^[🟢🔴▲▼≈+\-−]?\s*\d/.test(value);

          if (beginsWithNumber && value.includes('%')) {
            cell.classList.add('numeric-percent');
            percentColumns.add(index);
          }
        });
      });

      table.querySelectorAll('thead tr').forEach(function (row) {
        percentColumns.forEach(function (index) {
          const header = row.children[index];
          if (header) header.classList.add('numeric-percent-header');
        });
      });
    });

    document.querySelectorAll('.nav-dropdown-trigger').forEach(function (btn) {
      btn.addEventListener('click', function (e) {
        e.stopPropagation();
        const dropdown = btn.closest('.nav-dropdown');
        const isOpen = dropdown.classList.contains('open');
        document.querySelectorAll('.nav-dropdown.open').forEach(function (d) { d.classList.remove('open'); });
        if (!isOpen) {
          dropdown.classList.add('open');
          btn.setAttribute('aria-expanded', 'true');
        } else {
          btn.setAttribute('aria-expanded', 'false');
        }
      });
    });
    document.addEventListener('click', function () {
      document.querySelectorAll('.nav-dropdown.open').forEach(function (d) {
        d.classList.remove('open');
        d.querySelector('.nav-dropdown-trigger').setAttribute('aria-expanded', 'false');
      });
    });
  </script>
</div>
</body>
</html>
